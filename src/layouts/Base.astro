---
import '../styles/global.css';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import { langs, swapLang, t, type Lang } from '../i18n/ui';

interface Props {
  lang: Lang;
  title: string;
}

const { lang, title } = Astro.props;
const path = Astro.url.pathname;
const site = Astro.site!;
---

<!doctype html>
<html lang={lang === 'fr' ? 'fr-CA' : 'en-CA'}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <!-- Hidden from search engines until launch -->
    <meta name="robots" content="noindex" />
    <title>{title} | {t(lang, 'site.name')}</title>
    <link rel="icon" href="/images/favicon-user-circle.ico" />
    {langs.map((l) => <link rel="alternate" hreflang={l} href={new URL(swapLang(path, l), site)} />)}
    <meta name="theme-color" content="#F7F8FC" media="(prefers-color-scheme: light)" />
    <meta name="theme-color" content="#11121F" media="(prefers-color-scheme: dark)" />
    <!-- Apply a saved theme before the page paints, so it never flashes the wrong one -->
    <script is:inline>
      try {
        const saved = localStorage.getItem('theme');
        if (saved === 'light' || saved === 'dark') document.documentElement.dataset.theme = saved;
      } catch {}
      document.documentElement.classList.add('js');
    </script>
  </head>
  <body>
    <Header lang={lang} />
    <main id="main">
      <div class="wrap">
        <slot />
      </div>
    </main>
    <Footer lang={lang} />
  </body>
</html>

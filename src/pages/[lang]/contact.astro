---
import Base from '../../layouts/Base.astro';
import { langs, links, t, type Lang } from '../../i18n/ui';

export function getStaticPaths() {
  return langs.map((lang) => ({ params: { lang } }));
}

const lang = Astro.params.lang as Lang;
---

<Base lang={lang} title={t(lang, 'contact.title')}>
  <h1>{t(lang, 'contact.title')}</h1>
  <p>{t(lang, 'contact.placeholder')}</p>
  <p><a href={links.linkedin}>LinkedIn</a> · <a href={links.github}>GitHub</a></p>
</Base>
